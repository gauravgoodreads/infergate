# Shared state. Set REDIS_REQUIRED=true in production so the process fails fast
# instead of silently degrading to a per-replica in-process cache.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_REQUIRED=false

# Upstream providers, tried in order.
UPSTREAM_URL=http://127.0.0.1:9100/v1/complete
UPSTREAM_FALLBACK_URL=http://127.0.0.1:9101/v1/complete
UPSTREAM_TIMEOUT_S=20

# Set to route through a real OpenAI-compatible provider.
# GROQ_API_KEY=

# Caching. 0.78 is calibrated in bench/calibrate.py - see README.
CACHE_ENABLED=true
SEMANTIC_ENABLED=true
SEMANTIC_THRESHOLD=0.78
CACHE_TTL_S=3600
SEMANTIC_INDEX_CAP=20000

# Request coalescing.
COALESCE_ENABLED=true
COALESCE_LOCK_TTL_S=30

# Circuit breaker.
BREAKER_ENABLED=true
BREAKER_FAIL_THRESHOLD=5
BREAKER_RESET_TIMEOUT_S=10

# Rate limiting, per API key.
LIMITER_ENABLED=true
LIMITER_RATE_PER_S=200
LIMITER_BURST=400
